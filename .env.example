# E9 local single-team examples. No production, staging, model key, or real credentials.
# scripts/dev.py accepts this file but preserves an existing .env; process env takes precedence.
DATABASE_URL=postgresql+psycopg://sim@127.0.0.1:55432/simulation
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
SIM_API_URL=http://127.0.0.1:8000
# Local launcher generates 0600 files. Registry stores hashes, never bearer values.
SIM_ACCESS_REGISTRY=.local/access/access-grants.json
SIM_TOKEN_FILE=.local/access/operator.token
# Generated example identities only; launcher supplies a separate bundle to each process.
EXAMPLE_CREDENTIAL_FILE=.local/example-credentials-platform.json
EXAMPLE_TEST_MODE=1
EXAMPLE_PROVIDER_ORIGIN=http://127.0.0.1:8002
EXAMPLE_API_ORIGIN=http://127.0.0.1:8000
# Fixed exact origins; contracts cannot add destinations. DNS must resolve only to approved IPs.
EXAMPLE_OUTBOUND_POLICY={"http://127.0.0.1:8000":["127.0.0.1"],"http://127.0.0.1:8001":["127.0.0.1"],"http://127.0.0.1:8002":["127.0.0.1"],"http://127.0.0.1:8003":["127.0.0.1"]}
SIM_PG_DIRECTORY=.local/postgres
NEXT_TELEMETRY_DISABLED=1
# Test/acceptance overrides are optional and never point at production:
# TEST_DATABASE_URL=postgresql+psycopg://sim@127.0.0.1:55432/simulation
# ACCEPTANCE_EVIDENCE_DIR=docs/evidence/e9-rerun
# SIM_PNPM_STORE=.local/pnpm-store
# Retention is immutable contract policy: artifacts.trace_retention_days=30,
# artifacts.raw_retention_days=7, artifacts.redact_secrets=true.
# Web stays at 127.0.0.1:3000. Its proxy is fixed to 127.0.0.1:8000 and needs a browser session.
